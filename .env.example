# Kopiere diese Datei nach ".env" und trage deine Tokens ein.
# Die .env-Datei NIEMALS teilen oder hochladen!

# Haupt-Bot
DISCORD_TOKEN=

# Worker-Bots fuer schnelles Muten (kommagetrennt, darf leer sein)
WORKER_TOKENS=

# Datenbank (optional): leer lassen = SQLite-Datei data/crewbot.db.
# Fuer MySQL/MariaDB (z.B. Pelican-Panel -> Datenbanken) alle vier Werte eintragen:
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
